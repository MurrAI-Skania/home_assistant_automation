# --- Home Assistant: secrets & runtime noise ---
ha_config/**/secrets.yaml

ha_config/**/*.db*
ha_config/**/*.log*
ha_config/**/home-assistant_v2.db*
ha_config/**/home-assistant.log*

# Optional: generated media/cache folders (keep if you need them)
ha_config/tts/
ha_config/www/community/

# Default: ignore HA UI storage (we'll migrate helpers/dashboards to YAML)
ha_config/.storage/**

# --- Full HA config snapshots (raw mirrors) ---
ha_config_full_*/
ha_config_full/**

# --- Environment / credentials ---
.envrc
.gcp-credentials.json
